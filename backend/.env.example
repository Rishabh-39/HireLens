# ---- Server ----
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
DATABASE_URL="postgresql://user:password@host:port/database"

# ---- JWT ----
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Gemini AI (skill extraction from resume) ----
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# ---- Google Custom Search (career page discovery) ----
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ---- Adzuna (live job listings) ----
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# ---- Greenhouse / Lever / Ashby (public board APIs — no keys needed) ----
# Greenhouse: https://boards-api.greenhouse.io/v1/boards/{company_token}/jobs
# Lever:      https://api.lever.co/v0/postings/{company_slug}
# Ashby:      https://api.ashbyhq.com/posting-api/job-board/{company_slug}
